name = "irontrip-contact-proxy"
main = "src/index.js"
compatibility_date = "2025-01-01"

[vars]
# Set these via `wrangler secret put` for security
# RECAPTCHA_SECRET = "..."
# FORMSPREE_MAP = '{"contact":"https://formspree.io/f/xblzderv"}'
# FORM_ENDPOINT = "https://formspree.io/f/xblzderv" # optional fallback
# ALLOWED_ORIGIN = "https://irontrip.github.io"
